  "cards": [
    {
      "dot": "cyan",
      "title": "Detection owns the facts",
      "items": [
        "Rules detect anomalies and snapshot problems.",
        "The model writes advice; it does not decide case status."
      ]
    },
    {
      "dot": "emerald",
      "title": "Actions and cases differ",
      "items": [
        "Completing an action does not close its case.",
        "Recovery requires absence; capture requires a measured objective."
      ]
    },
    {
      "dot": "amber",
      "title": "Read alongside the review",
      "items": [
        "Trend recommendations precede cross-metric corroboration.",
        "Snapshot findings join case sync without this AI step."
      ]
    }
  ]
}