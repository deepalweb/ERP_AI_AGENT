      "label": "run",
      "role": "main"
    },
    {
      "from": "data",
      "to": "detect",
      "label": "read",
      "role": "branch"
    },
    {
      "from": "detect",
      "to": "evidence",
      "label": "flagged",
      "role": "main"
    },
    {
      "from": "evidence",
      "to": "narrate",
      "label": "ground",
      "role": "main"
    },
    {
      "from": "narrate",
      "to": "sync",
      "label": "findings",
      "role": "main"
    },
    {
      "from": "sync",
