# Reporting access: use a read-only Odoo PostgreSQL account.
REPORTING_DATABASE_URL=postgresql+psycopg://report_user:replace-me@localhost/odoo
APP_DATABASE_URL=sqlite:///./app.db

# Default: local computer only. For shared access, set basic and both credentials.
APP_AUTH_MODE=local
APP_AUTH_USERNAME=
APP_AUTH_PASSWORD=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Daily briefing at 05:00 Sri Lanka time. Disable on workers that should not schedule.
ENABLE_SCHEDULER=true
APP_TIMEZONE=Asia/Colombo
# Optional override; defaults to a separate .scan.lock file beside APP_DATABASE_URL.
# All workers sharing app state must use the same file on a shared filesystem.
# APP_SCAN_LOCK_PATH=C:/Celeste/data/app.db.scan.lock

# OpenAI-compatible provider; the default model uses NVIDIA's endpoint.
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
OPENAI_MODEL=nvidia/nemotron-3-super-120b-a12b
# Alternatively, omit NVIDIA_BASE_URL/NVIDIA_API_KEY and configure an OpenAI model.
# OPENAI_API_KEY=
