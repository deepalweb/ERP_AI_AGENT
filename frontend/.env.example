# Defaults to /api on the frontend's origin.
# Vite dev proxies /api to http://127.0.0.1:8000.
# Production: route /api/* to the backend, stripping the /api prefix.
VITE_API_BASE_URL=/api

# For a separate API origin, set its HTTPS URL and configure CORS_ORIGINS
# in the backend. VITE_* values are public: never put passwords or API keys here.
